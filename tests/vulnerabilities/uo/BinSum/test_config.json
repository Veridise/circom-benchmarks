{
    "src_path": "src",
    "language": "circom",
    "timeout": 300,
    "save_artifacts": false,
    "debug": true,
    "circom_template":
    {
        "BinSum@circomspect@n=2@ops=2.circom": {
            "BinSum": {
                "args": [
                    "n",
                    "ops"
                ],
                "values" : {
                    "n": 2,
                    "ops": 2
                },
                "signals": [
                    {
                        "name": "in",
                        "signal_type": "Input",
                        "array_constraints": ["ops", "n"]
                    },
                    {
                        "name": "out",
                        "signal_type": "Output",
                        "array_constraints": ["ops", "n"]
                    }
                ]
            }
        }
    }
}
